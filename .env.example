DB_CONNECTION_STRING=postgresql+asyncpg://user:password@localhost:5432/tenders
DB_ECHO=false
MAX_POOL_SIZE=10
MAX_OVERFLOW=20
POOL_TIMEOUT=30

# Required by docker-compose.yml only (db container + app's DB_CONNECTION_STRING
# inside Docker) - the app itself never reads these three directly, only
# the DB_CONNECTION_STRING above for a non-Docker run.
DB_USER=change-me
DB_PASSWORD=change-me
DB_NAME=change-me

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_USER_ID_CLAIM=sub

REQUEST_BODY_MAX_SIZE=32768

REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

LOG_LEVEL=INFO
